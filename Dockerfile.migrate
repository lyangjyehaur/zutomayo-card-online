FROM node:22.22.2-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f

WORKDIR /app

# Keep migration dependencies and source in a dedicated image so deployment
# never builds migrations from an unrelated checkout.
RUN apk upgrade --no-cache \
    && npm install --global --prefix /opt/npm npm@12.0.1 \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
    && ln -s /opt/npm/bin/npm /usr/local/bin/npm \
    && ln -s /opt/npm/bin/npx /usr/local/bin/npx \
    && npm cache clean --force
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY migrations ./migrations
COPY api/schemaGate.cjs ./api/schemaGate.cjs
COPY api/deckSharingConfig.cjs ./api/deckSharingConfig.cjs
COPY api/runtimeSecurityConfig.cjs ./api/runtimeSecurityConfig.cjs
COPY api/officialRulingsSource.cjs ./api/officialRulingsSource.cjs
COPY api/knowledgeSearchDocuments.cjs ./api/knowledgeSearchDocuments.cjs
COPY api/knowledgeSearchService.cjs ./api/knowledgeSearchService.cjs
COPY api/knowledgeSearchSynonyms.cjs ./api/knowledgeSearchSynonyms.cjs
COPY api/cardDataService.cjs ./api/cardDataService.cjs
COPY api/cardOrder.cjs ./api/cardOrder.cjs
COPY api/officialRulingsService.cjs ./api/officialRulingsService.cjs
COPY api/officialRuleDocumentsService.cjs ./api/officialRuleDocumentsService.cjs
COPY api/adminService.cjs ./api/adminService.cjs
COPY api/observability.cjs ./api/observability.cjs
COPY api/relationshipEvents.cjs ./api/relationshipEvents.cjs
COPY api/accountMutationLock.cjs ./api/accountMutationLock.cjs
COPY api/accountLifecycleService.cjs ./api/accountLifecycleService.cjs
COPY api/accountExportService.cjs ./api/accountExportService.cjs
COPY api/legalHoldService.cjs ./api/legalHoldService.cjs
COPY api/relationshipOutbox.cjs ./api/relationshipOutbox.cjs
COPY api/adminAuthService.cjs ./api/adminAuthService.cjs
COPY api/adminCredentialService.cjs ./api/adminCredentialService.cjs
COPY api/adminSecretCrypto.cjs ./api/adminSecretCrypto.cjs
COPY scripts/db-migrate.cjs ./scripts/db-migrate.cjs
COPY scripts/migration-checksums.cjs ./scripts/migration-checksums.cjs
COPY scripts/migration-order-compat.cjs ./scripts/migration-order-compat.cjs
COPY scripts/migration-lineage-pg-smoke.cjs ./scripts/migration-lineage-pg-smoke.cjs
COPY scripts/backfill-legacy-deleted-accounts-pg.cjs ./scripts/backfill-legacy-deleted-accounts-pg.cjs
COPY scripts/platform-schema-gate-pg-smoke.cjs ./scripts/platform-schema-gate-pg-smoke.cjs
COPY scripts/postgres-role-gate.cjs ./scripts/postgres-role-gate.cjs
COPY scripts/postgres-role-tls-smoke.cjs ./scripts/postgres-role-tls-smoke.cjs
COPY scripts/db-schema-gate.cjs ./scripts/db-schema-gate.cjs
COPY scripts/card-data-gate.cjs ./scripts/card-data-gate.cjs
COPY scripts/release-card-data.cjs ./scripts/release-card-data.cjs
COPY scripts/link-admin-user.cjs ./scripts/link-admin-user.cjs
COPY scripts/audit-card-official-texts.ts ./scripts/audit-card-official-texts.ts
COPY scripts/import-card-official-texts-pg.ts ./scripts/import-card-official-texts-pg.ts
COPY scripts/verify-compose-role-env.mjs ./scripts/verify-compose-role-env.mjs
COPY scripts/create-admin.cjs ./scripts/create-admin.cjs
COPY scripts/relationship-outbox-pg-smoke.cjs ./scripts/relationship-outbox-pg-smoke.cjs
COPY scripts/admin-credential-pg-smoke.cjs ./scripts/admin-credential-pg-smoke.cjs
COPY scripts/redrive-relationship-outbox.cjs ./scripts/redrive-relationship-outbox.cjs
COPY scripts/reindex-knowledge-search.cjs ./scripts/reindex-knowledge-search.cjs
COPY scripts/officialRulingsData.ts ./scripts/officialRulingsData.ts
COPY scripts/release-official-content.sh ./scripts/release-official-content.sh
COPY scripts/release-official-rulings.ts ./scripts/release-official-rulings.ts
COPY scripts/release-official-rule-documents.ts ./scripts/release-official-rule-documents.ts
COPY scripts/cardNameTranslations.ts ./scripts/cardNameTranslations.ts
COPY scripts/audit-card-derived-names.ts ./scripts/audit-card-derived-names.ts
COPY scripts/import-card-derived-names-pg.ts ./scripts/import-card-derived-names-pg.ts
COPY scripts/cardDerivedEffects.ts ./scripts/cardDerivedEffects.ts
COPY scripts/import-card-derived-effects-pg.ts ./scripts/import-card-derived-effects-pg.ts
COPY scripts/reviewedUnlistedCardRelease.ts ./scripts/reviewedUnlistedCardRelease.ts
COPY scripts/release-reviewed-unlisted-cards.ts ./scripts/release-reviewed-unlisted-cards.ts
COPY src/game/effects/parser.ts ./src/game/effects/parser.ts
COPY src/game/effects/types.ts ./src/game/effects/types.ts
COPY src/game/types.ts ./src/game/types.ts
COPY src/rulesTerminology.ts ./src/rulesTerminology.ts

USER node
CMD ["npm", "run", "db:migrate:release"]
